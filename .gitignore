# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Electron build output (large binaries — distributed via GitHub Releases)
release/
# Keep the auto-update metadata files (needed by electron-updater)
!release/*.yml
!release/*.yaml

# Vite / TS cache
.vite/
*.tsbuildinfo

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env.signing

# Tesseract engine files are copied from node_modules at build time (scripts/setup-tesseract.mjs).
# Only the language data is committed.
public/tesseract/worker.min.js
public/tesseract/*.wasm
public/tesseract/*.wasm.js
