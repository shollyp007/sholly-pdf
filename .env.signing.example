# Copy this to .env.signing and fill in your values before building for release.
# Load it before building: source .env.signing && npm run electron:build:mac

# Your Apple ID email
APPLE_ID=olusolaadeaga@gmail.com

# App-specific password — generate at appleid.apple.com → Sign-In and Security → App-Specific Passwords
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Your 10-character Team ID — find it at developer.apple.com/account → Membership Details
APPLE_TEAM_ID=XXXXXXXXXX
